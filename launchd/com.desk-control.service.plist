<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.desk-control.service</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jorgen/.local/bin/poetry</string>
        <string>run</string>
        <string>uvicorn</string>
        <string>service:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8842</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jorgen/JorgenKrieger/desk-control</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/jorgen/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/jorgen/Library/Logs/desk-control.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jorgen/Library/Logs/desk-control.log</string>
</dict>
</plist>
